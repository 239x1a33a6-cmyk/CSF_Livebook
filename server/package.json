{
    "name": "server",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "tsx watch --env-file=../.env src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "test": "jest --forceExit"
    },
    "dependencies": {
        "@prisma/client": "^5.14.0",
        "@types/multer": "^2.3.0",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.6",
        "express": "^4.19.2",
        "express-rate-limit": "^7.3.1",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.4.0",
        "pdf-parse": "^2.4.5",
        "pdf.js-extract": "^1.0.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.7",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.12",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/node": "^20.14.2",
        "@types/supertest": "^6.0.2",
        "jest": "^29.7.0",
        "prisma": "^5.14.0",
        "supertest": "^7.0.0",
        "ts-jest": "^29.1.5",
        "tsx": "^4.15.1",
        "typescript": "^5.4.5"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": [
            "<rootDir>/src"
        ],
        "testMatch": [
            "**/__tests__/**/*.test.ts"
        ]
    }
}
