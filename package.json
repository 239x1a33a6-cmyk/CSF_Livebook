{
  "name": "cs-fundamentals",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "db:generate": "npx prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "npx prisma db push --schema=./prisma/schema.prisma",
    "db:seed": "npx tsx ./prisma/seed.ts",
    "db:studio": "npx prisma studio --schema=./prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "concurrently": "^8.2.2",
    "prisma": "^8.0.0-rc.19",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}